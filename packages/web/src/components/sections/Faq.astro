---
import { Plus } from "@lucide/astro";

import { FAQ, LINKS } from "@/consts";
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="relative w-full overflow-hidden min-h-screen"
>
  <!-- Background: tentacles framing the centered FAQ -->
  <div
    class="absolute inset-0 z-0 flex items-center justify-center select-none pointer-events-none"
    aria-hidden="true"
  >
    <img
      data-img-reveal
      src="/images/faq.webp"
      alt=""
      width="1591"
      height="989"
      loading="lazy"
      decoding="async"
      class="h-auto w-full md:w-8/10 object-contain opacity-80"
    />
    <!-- Darken the center so the centered FAQ stays readable; the tentacles
         keep glowing toward the edges. -->
    <div
      class="absolute inset-0 bg-[radial-gradient(40%_60%_at_50%_50%,var(--background)_38%,transparent_100%)] md:bg-[radial-gradient(30%_45%_at_50%_50%,var(--background)_38%,transparent_100%)]"
    >
    </div>
  </div>

  <div class="relative z-10 container mx-auto px-6">
    <div class="mx-auto flex max-w-2xl flex-col gap-12">
      <!-- Heading (centered) -->
      <div class="flex flex-col items-center gap-4 text-center">
        <p
          data-reveal
          class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground"
        >
          ???
        </p>
        <h2
          id="faq-heading"
          data-split
          class="font-heading text-[clamp(3.75rem,5.5vw,6.5rem)] uppercase leading-[0.85] tracking-wide"
        >
          FAQ
        </h2>
        <p class="max-w-md text-sm text-foreground/60">
          What agents and sellers need to know about paying on Sui. Full
          protocol details live in the <a
            href={LINKS.faq}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-dotted underline-offset-4 transition-colors hover:text-primary"
            >docs</a
          >.
        </p>
      </div>

      <!-- Questions (single column) -->
      <div data-reveal-group class="flex flex-col">
        {
          FAQ.map((item, i) => (
            <details
              name="faq"
              class="group border-b border-border first:border-t"
              open={i === 0}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 [&::-webkit-details-marker]:hidden">
                <h3 class="text-base font-medium text-foreground transition-colors group-hover:text-primary">
                  {item.q}
                </h3>
                <Plus class="size-4 shrink-0 text-primary transition-transform duration-200 group-open:rotate-45" />
              </summary>
              <p class="pb-6 text-sm leading-relaxed text-foreground/60">
                {item.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
